{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "urls": "http://*:5000",
  "ProSettings": {
    "NavTheme": "light",
    "Layout": "side",
    "ContentWidth": "Fluid",
    "FixedHeader": false,
    "FixSiderbar": true,
    "Title": "GraphRag.Net",
    "PrimaryColor": "daybreak",
    "ColorWeak": false,
    "SplitMenus": false,
    "HeaderRender": true,
    "FooterRender": true,
    "MenuRender": true,
    "MenuHeaderRender": true,
    "HeaderHeight": 48
  },
  "GraphOpenAI": {
    "Key": "你的秘钥，注册antskapi享受2折优惠",
    "EndPoint": "https://api.antsk.cn/",
    "ChatModel": "gpt-4o",
    "EmbeddingModel": "text-embedding-ada-002"
  },
  "TextChunker": {
    "LinesToken": 100,
    "ParagraphsToken": 1000
  },
  "GraphDBConnection": {
    "DbType": "Sqlite", //PostgreSQL
    "DBConnection": "Data Source=graph.db",
    "VectorConnection": "graphmem.db",
    "VectorSize": 1536 //PostgreSQL，需要设置，sqlite可以不设置
  },
  "GraphSearch": {
    "SearchMinRelevance": 0.5,
    "SearchLimit": 3,
    "NodeDepth": 3,
    "MaxNodes":10
  },
  "GraphQuery": {
    "BasicSearchTopK": 5,
    "BasicSearchMinRelevance": 0.3,
    "DynamicCommunitySelection": true,
    "MaxCommunityReports": 20,
    "MapBatchTokens": 6000,
    "MapMaxLength": 800,
    "ReduceMaxLength": 1200,
    "MaxReduceTokens": 12000,
    "MinPointScore": 1,
    "ConcurrentCoroutines": 4,
    "QuestionCount": 5,
    "MaxReportFindings": 8,
    "ResponseType": "多段落、结构清晰的中文回答",
    "CommunityMaxLevels": 3,
    "CommunityMinSize": 1,
    "GlobalCommunityLevel": -1,
    "EnableGraphStats": true,
    "LocalTextUnitProp": 0.5,
    "LocalCommunityProp": 0.2,
    "LocalMaxContextTokens": 12000,
    "LocalTopKEntities": 10,
    "LocalTopKRelationships": 10,
    "LocalMaxConversationTurns": 5,
    "EnableClaimExtraction": false,
    "ClaimMaxPerTextUnit": 10,
    "DynamicSelectionMode": "llm",
    "DynamicSearchThreshold": 50,
    "DynamicKeepParent": true,
    "DynamicNumRepeats": 1,
    "DynamicMaxLevel": -1,
    "DriftKFollowups": 3,
    "DriftPrimerFolds": 2,
    "DriftNDepth": 2,
    "DriftConcurrency": 3,
    "IncrementalEnabled": true,
    "PromptTuneSampleSize": 5,
    "PromptTuneEntityTypes": 8
  },
  "GraphSys": {
    "RetryCounnt": 2 //重试次数，使用国产模型可能会出现json提取失败，增加重试次数可提高可用性
  },
  "PiAgent": {
    "EnableAgentLoop": true, // pi.net agent loop 总开关；false 回退经典单提示词链路
    "MaxTurns": 6 // 智能体循环决策最大回合数（工具调用 + 结果迭代）
  }
}
